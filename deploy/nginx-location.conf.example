# Add inside your existing TLS server block. Create a dedicated, strong
# Basic Auth htpasswd OUTSIDE the git repository.
location = /room-gpt-live/ws {
    auth_basic "Codex Voice";
    auth_basic_user_file /etc/nginx/codex-voice.htpasswd;
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:18771/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host 127.0.0.1:18771;
    proxy_buffering off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    add_header Cache-Control "no-store" always;
}
